#include <iostream>
using namespace std;

int tree[100];

// Pre-order: Root Left Right
void preorder(int i)
{
    if(i >= 100 || tree[i] == -1)
        return;

    cout << tree[i] << " ";
    preorder(2*i+1);
    preorder(2*i+2);
}

// In-order: Left Root Right
void inorder(int i)
{
    if(i >= 100 || tree[i] == -1)
        return;

    inorder(2*i+1);
    cout << tree[i] << " ";
    inorder(2*i+2);
}

// Post-order: Left Right Root
void postorder(int i)
{
    if(i >= 100 || tree[i] == -1)
        return;

    postorder(2*i+1);
    postorder(2*i+2);
    cout << tree[i] << " ";
}

int main()
{
    for(int i = 0; i < 100; i++)
        tree[i] = -1;

    tree[0] = 50;
    tree[1] = 30;
    tree[2] = 70;
    tree[3] = 20;
    tree[4] = 40;

    cout << "Pre-order: ";
    preorder(0);

    cout << "\nIn-order: ";
    inorder(0);

    cout << "\nPost-order: ";
    postorder(0);

    return 0;
}
