#include <iostream>
using namespace std;

int tree[100];

void insert(int x)
{
    int i=0;

    while(tree[i]!=-1)
    {
        if(x<tree[i])
            i=2*i+1;      // Go left
        else
            i=2*i+2;      // Go right
    }

    tree[i]=x;             // Insert value
}

void display()
{
    for(int i=0;i<100;i++)
    {
        if(tree[i]!=-1)
            cout<<tree[i]<<" ";
    }
}

int main()
{
    // Make all positions empty
    for(int i=0;i<100;i++)
        tree[i]=-1;

    insert(50);
    insert(30);
    insert(70);
    insert(20);
    insert(40);
    insert(60);
    insert(80);

    display();

    return 0;
}
