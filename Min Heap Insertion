#include <iostream>
using namespace std;

int heap[100];
int n = 0;

void insert(int x)
{
    int i = n;
    heap[i] = x;
    n++;

    while (i > 0 && heap[(i - 1) / 2] > heap[i])
    {
        swap(heap[i], heap[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

int main()
{
    insert(2);
    insert(1);

    cout << "Min Heap: ";

    for (int i = 0; i < n; i++)
        cout << heap[i] << " ";

    return 0;
}
