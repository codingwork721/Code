#include <iostream>
using namespace std;

int heap[100];
int n = 0;

void insert(int x)
{
    int i = n;
    heap[i] = x;
    n++;

    while (i > 0 && heap[(i - 1) / 2] > heap[i])
    {
        swap(heap[i], heap[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

void deleteMin()
{
    if (n == 0)
    {
        cout << "Heap is empty!" << endl;
        return;
    }

    cout << "Deleted element: " << heap[0] << endl;

    heap[0] = heap[n - 1];
    n--;

    int i = 0;

    while (true)
    {
        int left = 2 * i + 1;
        int right = 2 * i + 2;
        int smallest = i;

        if (left < n && heap[left] < heap[smallest])
            smallest = left;

        if (right < n && heap[right] < heap[smallest])
            smallest = right;

        if (smallest == i)
            break;

        swap(heap[i], heap[smallest]);
        i = smallest;
    }
}

int main()
{
    insert(10);
    insert(20);
    insert(30);
    insert(40);
    insert(50);

    cout << "Min Heap: ";
    for (int i = 0; i < n; i++)
        cout << heap[i] << " ";

    cout << endl;

    deleteMin();

    cout << "After Deletion: ";
    for (int i = 0; i < n; i++)
        cout << heap[i] << " ";

    return 0;
}
